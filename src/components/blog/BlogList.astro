---
// src/components/blog/BlogList.astro
// KODE LENGKAP YANG SUDAH DIPERBAIKI

import BlogPost from '@components/blog/BlogPost.astro';

interface Props {
    posts: any[];
}

const { posts } = Astro.props;
---

{/* 
    Elemen <section> pembungkus telah dihapus dari sini.
    Komponen ini sekarang akan dirender di dalam kontainer milik induknya.
*/}

<div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="text-lg font-semibold">Artikel terbaru</h2>
        <p class="mt-1 text-small text-body-base">
            Menampilkan <span class="font-bold text-primary">{posts.length}</span> artikel pada halaman ini.
        </p>
    </div>
    <a
        href="/search"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-primary px-5 py-2 text-small font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
    >
        Cari artikel
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {
        posts.map((post, index) => (
            <div>
                <BlogPost
                    title={post.data.title}
                    excerpt={post.data.excerpt}
                    featuredImage={post.data.featuredImage}
                    publishDate={post.data.publishDate}
                    categories={post.data.categories || []}
                    slug={post.slug}
                    index={index}
                />
            </div>
        ))
    }
</div>

{posts.length === 0 && <p class="py-8 text-center text-gray-500">Belum ada artikel untuk ditampilkan.</p>}
